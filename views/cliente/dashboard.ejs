<%- include('../common/head', { title: 'Dashboard Cliente - MechFinder' }) %>
<body>
    <div class="dashboard-container">
        <%- include('../common/sidebar-cliente', { 
            active: 'dashboard',
            user: user
        }) %>
        
        <div class="dashboard-main">
            <!-- Header fisso -->
            <div class="dashboard-header">
                <div class="header-title">
                    <h2>Dashboard Cliente</h2>
                    <p class="text-muted mb-0">Benvenuto, <%= user.nome %></p>
                </div>
                
                <div class="header-user">
                    <div class="notifications me-3">
                        <div class="dropdown">
                            <button class="btn btn-light position-relative notification-btn" type="button" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-bell"></i>
                                <% if (typeof riparazioniAttive !== 'undefined' && riparazioniAttive && riparazioniAttive.length > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        <%= riparazioniAttive.length %>
                                        <span class="visually-hidden">notifiche non lette</span>
                                    </span>
                                <% } %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationsDropdown">
                                <div class="notification-header p-2 border-bottom d-flex justify-content-between align-items-center">
                                    <h6 class="m-0">Notifiche</h6>
                                    <% if (typeof riparazioniAttive !== 'undefined' && riparazioniAttive && riparazioniAttive.length > 0) { %>
                                        <span class="badge bg-primary"><%= riparazioniAttive.length %></span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">0</span>
                                    <% } %>
                                </div>
                                
                                <% if (typeof riparazioniAttive !== 'undefined' && riparazioniAttive && riparazioniAttive.length > 0) { %>
                                    <% riparazioniAttive.forEach(riparazione => { %>
                                        <li>
                                            <a class="dropdown-item notification-item" href="/cliente/riparazioni/<%= riparazione.id %>">
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-shrink-0 me-2">
                                                        <% if (riparazione.stato === 'in_attesa') { %>
                                                            <i class="fas fa-clock bg-warning text-white p-2 rounded-circle"></i>
                                                        <% } else if (riparazione.stato === 'accettata') { %>
                                                            <i class="fas fa-check bg-success text-white p-2 rounded-circle"></i>
                                                        <% } else if (riparazione.stato === 'in_corso') { %>
                                                            <i class="fas fa-wrench bg-primary text-white p-2 rounded-circle"></i>
                                                        <% } %>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <p class="mb-0">
                                                            <% if (riparazione.stato === 'in_attesa') { %>
                                                                Richiesta in attesa di risposta
                                                            <% } else if (riparazione.stato === 'accettata') { %>
                                                                Riparazione accettata
                                                            <% } else if (riparazione.stato === 'in_corso') { %>
                                                                Riparazione in corso
                                                            <% } %>
                                                        </p>
                                                        <small class="text-muted"><%= new Date(riparazione.data_richiesta).toLocaleDateString() %></small>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                    <% }) %>
                                <% } else { %>
                                    <li><p class="dropdown-item text-center text-muted py-2 mb-0">Nessuna nuova notifica</p></li>
                                <% } %>
                                
                                <li><hr class="dropdown-divider my-0"></li>
                                <li><a class="dropdown-item text-center py-2" href="/cliente/riparazioni">Vedi tutte le riparazioni</a></li>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="<%= user.avatar || '/media/img/default_avatar.png' %>" alt="<%= user.nome %>" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;">
                            <span><%= user.nome %> <%= user.cognome %></span>
                            <i class="fas fa-chevron-down ms-2 small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/cliente/profilo"><i class="fas fa-user-circle me-2"></i>Profilo</a></li>
                            <li><a class="dropdown-item" href="/cliente/impostazioni"><i class="fas fa-cog me-2"></i>Impostazioni</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="dashboard-content">
                <!-- Statistiche generali -->
                <div class="row">
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Riparazioni totali</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <% if (typeof stats !== 'undefined' && stats && stats.totalRiparazioni) { %>
                                                <%= stats.totalRiparazioni %>
                                            <% } else { %>
                                                <%= tutteRiparazioni?.length || 0 %>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-tools fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Riparazioni attive</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= riparazioniAttive ? riparazioniAttive.length : 0 %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">I miei veicoli</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= veicoli ? veicoli.length : 0 %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-car fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Spesa totale</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">€ <%= stats && stats.spesaTotale ? stats.spesaTotale.toFixed(2) : '0.00' %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-euro-sign fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Azioni Rapide -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">Azioni Rapide</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <button class="btn btn-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4" data-bs-toggle="modal" data-bs-target="#nuovaRiparazioneModal">
                                            <i class="fas fa-plus fa-2x mb-2"></i>
                                            <span>Richiedi Riparazione</span>
                                        </button>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <button class="btn btn-success w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4" data-bs-toggle="modal" data-bs-target="#nuovoVeicoloModal">
                                            <i class="fas fa-car fa-2x mb-2"></i>
                                            <span>Aggiungi Veicolo</span>
                                        </button>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <a href="/meccanici" class="btn btn-info w-100 h-100 d-flex flex-column align-items-center justify-content-center p-4 text-decoration-none">
                                            <i class="fas fa-search fa-2x mb-2"></i>
                                            <span>Trova Meccanici</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-content">
                        <h3><%= tutteRiparazioni?.filter(r => r.stato === 'in_corso' || r.stato === 'accettata').length || 0 %></h3>
                        <p>In Corso</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <h3><%= tutteRiparazioni?.filter(r => r.stato === 'completata').length || 0 %></h3>
                        <p>Completate</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-car"></i>
                    </div>
                    <div class="stat-content">
                        <h3><%= veicoli?.length || 0 %></h3>
                        <p>Veicoli Registrati</p>
                    </div>
                </div>
            </div>

            <!-- Riparazioni -->
            <div class="section">
                <h2>Le Tue Riparazioni</h2>
                <% if (tutteRiparazioni && tutteRiparazioni.length > 0) { %>
                    <div class="riparazioni-grid">
                        <% tutteRiparazioni.forEach(function(riparazione) { %>
                            <div class="riparazione-card">
                                <div class="card-header">
                                    <h3>Riparazione #<%= riparazione.id %></h3>
                                    <span class="status-badge status-<%= riparazione.stato %>">
                                        <%= riparazione.stato.charAt(0).toUpperCase() + riparazione.stato.slice(1) %>
                                    </span>
                                </div>
                                <div class="card-content">
                                    <% if (riparazione.meccanico_nome) { %>
                                        <p><strong>Meccanico:</strong> <%= riparazione.meccanico_nome %> <%= riparazione.meccanico_cognome %></p>
                                        <p><strong>Officina:</strong> <%= riparazione.nome_officina || 'N/A' %></p>
                                    <% } else { %>
                                        <p><strong>Stato:</strong> In attesa di assegnazione</p>
                                    <% } %>
                                    <p><strong>Veicolo:</strong> <%= riparazione.veicolo_marca || 'N/A' %> <%= riparazione.veicolo_modello || 'N/A' %></p>
                                    <p><strong>Tipo:</strong> <%= riparazione.tipo_servizio || riparazione.tipo_riparazione || 'Generale' %></p>
                                    <p><strong>Descrizione:</strong> <%= riparazione.descrizione || 'Nessuna descrizione' %></p>
                                    <p><strong>Data Richiesta:</strong> <%= new Date(riparazione.data_richiesta).toLocaleDateString('it-IT') %></p>
                                    <% if (riparazione.prezzo) { %>
                                        <p><strong>Prezzo:</strong> €<%= parseFloat(riparazione.prezzo).toFixed(2) %></p>
                                    <% } %>
                                </div>
                                <div class="card-actions">
                                    <% if (riparazione.stato === 'completata' && !riparazione.rating) { %>
                                        <button class="btn btn-primary" onclick="apriRecensione(<%= riparazione.id %>)">
                                            <i class="fas fa-star"></i> Recensisci
                                        </button>
                                    <% } %>
                                    <% if (riparazione.stato === 'completata') { %>
                                        <button class="btn btn-info" onclick="scaricaCertificato(<%= riparazione.id %>)">
                                            <i class="fas fa-download"></i> Certificato
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-tools"></i>
                        <p>Nessuna riparazione ancora</p>
                        <button class="btn btn-primary" onclick="richiediniRiparazione()">
                            Richiedi la tua prima riparazione
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- I Tuoi Veicoli -->
            <div class="section">
                <h2>I Tuoi Veicoli</h2>
                <% if (veicoli && veicoli.length > 0) { %>
                    <div class="veicoli-grid">
                        <% veicoli.forEach(function(veicolo) { %>
                            <div class="veicolo-card">
                                <div class="veicolo-info">
                                    <h4><%= veicolo.marca %> <%= veicolo.modello %></h4>
                                    <p><strong>Anno:</strong> <%= veicolo.anno %></p>
                                    <p><strong>Targa:</strong> <%= veicolo.targa %></p>
                                    <p><strong>Tipo:</strong> <%= veicolo.tipo_veicolo %></p>
                                </div>
                                <div class="veicolo-actions">
                                    <button class="btn btn-outline-primary" onclick="modificaVeicolo(<%= veicolo.id %>)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" onclick="eliminaVeicolo(<%= veicolo.id %>)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-car"></i>
                        <p>Nessun veicolo registrato</p>
                        <button class="btn btn-primary" onclick="aggiungiVeicolo()">
                            Aggiungi il tuo primo veicolo
                        </button>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <!-- Modal per recensione -->
    <div class="modal fade" id="recensioneModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Lascia una Recensione</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="recensioneForm">
                    <div class="modal-body">
                        <input type="hidden" id="riparazioneId" name="riparazioneId">
                        <div class="mb-3">
                            <label class="form-label">Valutazione</label>
                            <div class="rating-input">
                                <input type="radio" name="rating" value="5" id="star5">
                                <label for="star5" class="star">★</label>
                                <input type="radio" name="rating" value="4" id="star4">
                                <label for="star4" class="star">★</label>
                                <input type="radio" name="rating" value="3" id="star3">
                                <label for="star3" class="star">★</label>
                                <input type="radio" name="rating" value="2" id="star2">
                                <label for="star2" class="star">★</label>
                                <input type="radio" name="rating" value="1" id="star1">
                                <label for="star1" class="star">★</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="commento" class="form-label">Commento (opzionale)</label>
                            <textarea class="form-control" id="commento" name="commento" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-primary">Invia Recensione</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <%- include('../common/scripts') %>
    <script>
        // Funzioni JavaScript per la dashboard cliente
        function richiediniRiparazione() {
            // Implementare modal per richiesta riparazione
            alert('Funzione in sviluppo');
        }
        
        function aggiungiVeicolo() {
            // Implementare modal per aggiungere veicolo
            alert('Funzione in sviluppo');
        }
        
        function apriRecensione(riparazioneId) {
            document.getElementById('riparazioneId').value = riparazioneId;
            new bootstrap.Modal(document.getElementById('recensioneModal')).show();
        }
        
        function scaricaCertificato(riparazioneId) {
            window.open(`/cliente/download-ricevuta/${riparazioneId}`, '_blank');
        }
        
        // Gestione form recensione
        document.getElementById('recensioneForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            
            if (!data.rating) {
                alert('Seleziona una valutazione');
                return;
            }
            
            fetch('/cliente/aggiungi-recensione', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Recensione inviata con successo!');
                    bootstrap.Modal.getInstance(document.getElementById('recensioneModal')).hide();
                    location.reload();
                } else {
                    alert('Errore nell\'invio della recensione');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Errore di connessione');
            });
        });
    </script>
</body>
</html>
