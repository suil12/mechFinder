<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Dashboard Cliente - MechFinder">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .dashboard-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        .stat-card .card-body {
            padding: 2rem;
        }
        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        .stat-label {
            color: #6c757d;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .content-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border: none;
            margin-bottom: 2rem;
        }
        .content-card .card-header {
            background: transparent;
            border-bottom: 1px solid #eee;
            padding: 1.5rem;
            border-radius: 15px 15px 0 0;
        }
        .riparazione-item {
            border-left: 4px solid #dee2e6;
            padding: 1.5rem;
            margin-bottom: 1rem;
            background: #f8f9fa;
            border-radius: 0 10px 10px 0;
            transition: all 0.3s ease;
        }
        .riparazione-item:hover {
            background: #e9ecef;
            border-left-color: #007bff;
        }
        .riparazione-item.in_attesa {
            border-left-color: #ffc107;
        }
        .riparazione-item.accettata {
            border-left-color: #17a2b8;
        }
        .riparazione-item.in_corso {
            border-left-color: #007bff;
        }
        .riparazione-item.completata {
            border-left-color: #28a745;
        }
        .btn-action {
            border-radius: 25px;
            padding: 10px 20px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
        }
        .modal-content {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        .modal-header {
            border-bottom: 1px solid #eee;
            border-radius: 15px 15px 0 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .form-control {
            border-radius: 10px;
            border: 1px solid #ddd;
            padding: 12px 15px;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .icon-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }
        .icon-primary { background: rgba(0, 123, 255, 0.1); color: #007bff; }
        .icon-success { background: rgba(40, 167, 69, 0.1); color: #28a745; }
        .icon-info { background: rgba(23, 162, 184, 0.1); color: #17a2b8; }
        .icon-warning { background: rgba(255, 193, 7, 0.1); color: #ffc107; }
    </style>
</head>
<body>
    <%- include('../common/header') %>
    
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="h2 mb-2">
                        <i class="fas fa-tachometer-alt me-3"></i>
                        Benvenuto, <%= user.nome %> <%= user.cognome %>
                    </h1>
                    <p class="mb-0 opacity-75">Gestisci le tue riparazioni e veicoli in modo semplice e veloce</p>
                </div>
                <div class="col-md-4 text-end">
                    <button type="button" class="btn btn-light btn-action me-2" onclick="showCreaRiparazioneModal()">
                        <i class="fas fa-plus me-2"></i>Nuova Riparazione
                    </button>
                    <button type="button" class="btn btn-outline-light btn-action" onclick="showGestioneVeicoliModal()">
                        <i class="fas fa-car me-2"></i>I Miei Veicoli
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Alert Messages -->
        <% if (typeof success !== 'undefined' && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Statistiche Cards -->
        <div class="row mb-5">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card">
                    <div class="card-body text-center">
                        <div class="icon-wrapper icon-primary mx-auto">
                            <i class="fas fa-tools"></i>
                        </div>
                        <div class="stat-number text-primary"><%= stats.totalRiparazioni %></div>
                        <div class="stat-label">Totale Riparazioni</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card">
                    <div class="card-body text-center">
                        <div class="icon-wrapper icon-success mx-auto">
                            <i class="fas fa-cog fa-spin"></i>
                        </div>
                        <div class="stat-number text-success"><%= riparazioniAttive ? riparazioniAttive.length : 0 %></div>
                        <div class="stat-label">Riparazioni Attive</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card">
                    <div class="card-body text-center">
                        <div class="icon-wrapper icon-info mx-auto">
                            <i class="fas fa-car"></i>
                        </div>
                        <div class="stat-number text-info"><%= veicoli ? veicoli.length : 0 %></div>
                        <div class="stat-label">I Miei Veicoli</div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card stat-card">
                    <div class="card-body text-center">
                        <div class="icon-wrapper icon-warning mx-auto">
                            <i class="fas fa-euro-sign"></i>
                        </div>
                        <div class="stat-number text-warning">€<%= parseFloat(stats.spesaTotale || 0).toFixed(0) %></div>
                        <div class="stat-label">Spesa Totale</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Row -->
        <div class="row">
            <div class="col-lg-8">
                <!-- Riparazioni Attive -->
                <div class="card content-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-tools me-2"></i>Riparazioni Attive</h5>
                        <button class="btn btn-outline-primary btn-sm" onclick="showStoricoRiparazioniModal()">
                            <i class="fas fa-history me-1"></i>Storico Completo
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (riparazioniAttive && riparazioniAttive.length > 0) { %>
                            <% riparazioniAttive.forEach(function(riparazione) { %>
                                <div class="riparazione-item <%= riparazione.stato %>">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center mb-2">
                                                <span class="badge bg-<%= riparazione.stato === 'in_attesa' ? 'warning' : riparazione.stato === 'accettata' ? 'info' : riparazione.stato === 'in_corso' ? 'primary' : 'success' %> me-2">
                                                    <%= riparazione.stato.charAt(0).toUpperCase() + riparazione.stato.slice(1).replace('_', ' ') %>
                                                </span>
                                                <h6 class="mb-0"><%= riparazione.tipo_riparazione %></h6>
                                            </div>
                                            <p class="text-muted mb-1"><%= riparazione.descrizione %></p>
                                            <small class="text-muted">
                                                <i class="fas fa-car me-1"></i><%= riparazione.veicolo_marca %> <%= riparazione.veicolo_modello %>
                                                <% if (riparazione.nome_meccanico) { %>
                                                    | <i class="fas fa-user-cog ms-2 me-1"></i><%= riparazione.nome_meccanico %> <%= riparazione.cognome_meccanico %>
                                                <% } %>
                                            </small>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <% if (riparazione.costo) { %>
                                                <div class="h5 mb-2 text-success">€<%= parseFloat(riparazione.costo).toFixed(2) %></div>
                                            <% } %>
                                            <button class="btn btn-sm btn-outline-primary" onclick="viewRiparazioneDetails('<%= riparazione.id %>')">
                                                <i class="fas fa-eye me-1"></i>Dettagli
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-5">
                                <i class="fas fa-tools fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">Nessuna riparazione attiva</h5>
                                <p class="text-muted">Inizia creando una nuova richiesta di riparazione</p>
                                <button class="btn btn-primary btn-action" onclick="showCreaRiparazioneModal()">
                                    <i class="fas fa-plus me-2"></i>Crea Prima Riparazione
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- I Miei Veicoli -->
                <div class="card content-card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-car me-2"></i>I Miei Veicoli</h5>
                        <button class="btn btn-outline-primary btn-sm" onclick="showAggiungiVeicoloModal()">
                            <i class="fas fa-plus me-1"></i>Aggiungi
                        </button>
                    </div>
                    <div class="card-body">
                        <% if (veicoli && veicoli.length > 0) { %>
                            <% veicoli.slice(0, 3).forEach(function(veicolo) { %>
                                <div class="d-flex align-items-center mb-3 p-3 bg-light rounded">
                                    <div class="icon-wrapper icon-info me-3" style="width: 40px; height: 40px; font-size: 1rem;">
                                        <i class="fas fa-car"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1"><%= veicolo.marca %> <%= veicolo.modello %></h6>
                                        <small class="text-muted"><%= veicolo.anno %> • <%= veicolo.targa %></small>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminaVeicolo('<%= veicolo.id %>')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            <% }) %>
                            <% if (veicoli.length > 3) { %>
                                <button class="btn btn-sm btn-outline-primary w-100" onclick="showGestioneVeicoliModal()">
                                    Visualizza tutti (<%= veicoli.length %>)
                                </button>
                            <% } %>
                        <% } else { %>
                            <div class="text-center py-3">
                                <i class="fas fa-car fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-3">Nessun veicolo registrato</p>
                                <button class="btn btn-primary btn-sm" onclick="showAggiungiVeicoloModal()">
                                    <i class="fas fa-plus me-1"></i>Aggiungi Primo Veicolo
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Notifiche Recenti -->
                <div class="card content-card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-bell me-2"></i>Notifiche Recenti</h5>
                    </div>
                    <div class="card-body">
                        <% if (notifiche && notifiche.length > 0) { %>
                            <% notifiche.slice(0, 5).forEach(function(notifica) { %>
                                <div class="d-flex align-items-start mb-3 p-2 rounded bg-light">
                                    <div class="icon-wrapper icon-primary me-2" style="width: 30px; height: 30px; font-size: 0.8rem;">
                                        <i class="fas fa-info"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1" style="font-size: 0.9rem;"><%= notifica.titolo %></h6>
                                        <p class="mb-1 text-muted" style="font-size: 0.8rem;"><%= notifica.messaggio %></p>
                                        <small class="text-muted"><%= new Date(notifica.data_creazione).toLocaleDateString('it-IT') %></small>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-3">
                                <i class="fas fa-bell-slash fa-2x text-muted mb-2"></i>
                                <p class="text-muted">Nessuna notifica</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Crea Riparazione -->
    <div class="modal fade" id="creaRiparazioneModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Nuova Richiesta di Riparazione</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/cliente/crea-riparazione" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="id_veicolo" class="form-label">Seleziona Veicolo</label>
                                <select class="form-control" name="id_veicolo" required>
                                    <option value="">Scegli un veicolo...</option>
                                    <% if (veicoli) { %>
                                        <% veicoli.forEach(function(veicolo) { %>
                                            <option value="<%= veicolo.id %>"><%= veicolo.marca %> <%= veicolo.modello %> (<%= veicolo.targa %>)</option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="tipo_riparazione" class="form-label">Tipo di Riparazione</label>
                                <select class="form-control" name="tipo_riparazione" required>
                                    <option value="">Seleziona tipo...</option>
                                    <option value="Elettronica">Elettronica</option>
                                    <option value="Meccanica Generale">Meccanica Generale</option>
                                    <option value="Revisioni">Revisioni</option>
                                    <option value="Tagliandi">Tagliandi</option>
                                    <option value="Cambio Gomme">Cambio Gomme</option>
                                    <option value="Carrozzeria">Carrozzeria</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="urgenza" class="form-label">Urgenza</label>
                                <select class="form-control" name="urgenza">
                                    <option value="normale">Normale</option>
                                    <option value="urgente">Urgente</option>
                                    <option value="molto_urgente">Molto Urgente</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="budget_max" class="form-label">Budget Massimo (€)</label>
                                <input type="number" class="form-control" name="budget_max" min="0" step="0.01" placeholder="Es. 500.00">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="descrizione" class="form-label">Descrizione del Problema</label>
                            <textarea class="form-control" name="descrizione" rows="4" required placeholder="Descrivi dettagliatamente il problema del tuo veicolo..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane me-2"></i>Invia Richiesta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Gestione Veicoli -->
    <div class="modal fade" id="gestioneVeicoliModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-car me-2"></i>Gestione Veicoli</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs mb-3" id="veicoliTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="lista-tab" data-bs-toggle="tab" data-bs-target="#lista" type="button">
                                <i class="fas fa-list me-2"></i>I Miei Veicoli
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="aggiungi-tab" data-bs-toggle="tab" data-bs-target="#aggiungi" type="button">
                                <i class="fas fa-plus me-2"></i>Aggiungi Nuovo
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="veicoliTabsContent">
                        <!-- Lista Veicoli -->
                        <div class="tab-pane fade show active" id="lista" role="tabpanel">
                            <% if (veicoli && veicoli.length > 0) { %>
                                <% veicoli.forEach(function(veicolo) { %>
                                    <div class="card mb-3" id="veicolo-<%= veicolo.id %>">
                                        <div class="card-body">
                                            <div class="row align-items-center">
                                                <div class="col-md-8">
                                                    <h6 class="card-title mb-1"><%= veicolo.marca %> <%= veicolo.modello %></h6>
                                                    <p class="card-text text-muted mb-1">
                                                        <i class="fas fa-calendar me-1"></i>Anno: <%= veicolo.anno %>
                                                        <span class="ms-3"><i class="fas fa-id-card me-1"></i>Targa: <%= veicolo.targa %></span>
                                                    </p>
                                                    <% if (veicolo.cilindrata) { %>
                                                        <small class="text-muted">Cilindrata: <%= veicolo.cilindrata %>cc</small>
                                                    <% } %>
                                                </div>
                                                <div class="col-md-4 text-end">
                                                    <button class="btn btn-sm btn-outline-primary me-2" onclick="modificaVeicolo('<%= veicolo.id %>')">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminaVeicolo('<%= veicolo.id %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-4">
                                    <i class="fas fa-car fa-3x text-muted mb-3"></i>
                                    <h5 class="text-muted">Nessun veicolo registrato</h5>
                                    <p class="text-muted">Aggiungi il tuo primo veicolo usando il tab "Aggiungi Nuovo"</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- Aggiungi Veicolo -->
                        <div class="tab-pane fade" id="aggiungi" role="tabpanel">
                            <form action="/cliente/aggiungi-veicolo" method="POST" id="aggiungiVeicoloForm">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="marca" class="form-label">Marca</label>
                                        <input type="text" class="form-control" name="marca" required placeholder="Es. Fiat">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="modello" class="form-label">Modello</label>
                                        <input type="text" class="form-control" name="modello" required placeholder="Es. Punto">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="anno" class="form-label">Anno</label>
                                        <input type="number" class="form-control" name="anno" min="1950" max="<%= new Date().getFullYear() %>" required placeholder="Es. 2020">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="targa" class="form-label">Targa</label>
                                        <input type="text" class="form-control" name="targa" required placeholder="Es. AB123CD" style="text-transform: uppercase;">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="carburante" class="form-label">Carburante</label>
                                        <select class="form-control" name="carburante">
                                            <option value="">Seleziona...</option>
                                            <option value="Benzina">Benzina</option>
                                            <option value="Diesel">Diesel</option>
                                            <option value="GPL">GPL</option>
                                            <option value="Metano">Metano</option>
                                            <option value="Elettrico">Elettrico</option>
                                            <option value="Ibrido">Ibrido</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="cilindrata" class="form-label">Cilindrata (cc)</label>
                                        <input type="number" class="form-control" name="cilindrata" min="0" placeholder="Es. 1200">
                                    </div>
                                </div>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>Aggiungi Veicolo
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Aggiungi Veicolo (Veloce) -->
    <div class="modal fade" id="aggiungiVeicoloModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-car me-2"></i>Aggiungi Veicolo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/cliente/aggiungi-veicolo" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="marca" class="form-label">Marca</label>
                            <input type="text" class="form-control" name="marca" required placeholder="Es. Fiat">
                        </div>
                        <div class="mb-3">
                            <label for="modello" class="form-label">Modello</label>
                            <input type="text" class="form-control" name="modello" required placeholder="Es. Punto">
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label for="anno" class="form-label">Anno</label>
                                <input type="number" class="form-control" name="anno" min="1950" max="<%= new Date().getFullYear() %>" required>
                            </div>
                            <div class="col-6 mb-3">
                                <label for="targa" class="form-label">Targa</label>
                                <input type="text" class="form-control" name="targa" required style="text-transform: uppercase;">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Aggiungi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Storico Riparazioni -->
    <div class="modal fade" id="storicoRiparazioniModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-history me-2"></i>Storico Completo Riparazioni</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <% if (tutteRiparazioni && tutteRiparazioni.length > 0) { %>
                            <% tutteRiparazioni.forEach(function(riparazione) { %>
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-<%= riparazione.stato === 'completata' ? 'success' : riparazione.stato === 'in_corso' ? 'primary' : riparazione.stato === 'accettata' ? 'info' : riparazione.stato === 'rifiutata' ? 'danger' : 'warning' %>">
                                                    <%= riparazione.stato.charAt(0).toUpperCase() + riparazione.stato.slice(1).replace('_', ' ') %>
                                                </span>
                                                <small class="text-muted"><%= new Date(riparazione.data_richiesta).toLocaleDateString('it-IT') %></small>
                                            </div>
                                            <h6 class="card-title"><%= riparazione.tipo_riparazione %></h6>
                                            <p class="card-text text-muted small"><%= riparazione.descrizione.substring(0, 100) %>...</p>
                                            <div class="d-flex justify-content-between align-items-end">
                                                <small class="text-muted">
                                                    <i class="fas fa-car me-1"></i><%= riparazione.veicolo_marca %> <%= riparazione.veicolo_modello %>
                                                </small>
                                                <% if (riparazione.costo) { %>
                                                    <strong class="text-success">€<%= parseFloat(riparazione.costo).toFixed(2) %></strong>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-4">
                                <i class="fas fa-history fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">Nessuna riparazione trovata</h5>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../common/footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Funzioni per gestire i modal
        function showCreaRiparazioneModal() {
            new bootstrap.Modal(document.getElementById('creaRiparazioneModal')).show();
        }

        function showGestioneVeicoliModal() {
            new bootstrap.Modal(document.getElementById('gestioneVeicoliModal')).show();
        }

        function showAggiungiVeicoloModal() {
            new bootstrap.Modal(document.getElementById('aggiungiVeicoloModal')).show();
        }

        function showStoricoRiparazioniModal() {
            new bootstrap.Modal(document.getElementById('storicoRiparazioniModal')).show();
        }

        function viewRiparazioneDetails(id) {
            window.location.href = '/riparazioni/' + id;
        }

        function eliminaVeicolo(id) {
            if (confirm('Sei sicuro di voler eliminare questo veicolo?')) {
                fetch('/cliente/elimina-veicolo/' + id, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Errore nell\'eliminazione del veicolo');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Errore nell\'eliminazione del veicolo');
                });
            }
        }

        function modificaVeicolo(id) {
            // Implementa la modifica del veicolo
            alert('Funzione di modifica in sviluppo');
        }

        // Auto-uppercase per i campi targa
        document.addEventListener('DOMContentLoaded', function() {
            const targaInputs = document.querySelectorAll('input[name="targa"]');
            targaInputs.forEach(input => {
                input.addEventListener('input', function() {
                    this.value = this.value.toUpperCase();
                });
            });
        });
    </script>
</body>
</html>
