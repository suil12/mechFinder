<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Dashboard Admin - MechFinder">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .admin-stat-card {
            transition: transform 0.2s ease-in-out;
        }
        .admin-stat-card:hover {
            transform: translateY(-5px);
        }
        .border-left-primary {
            border-left: 4px solid #4e73df !important;
        }
        .border-left-success {
            border-left: 4px solid #1cc88a !important;
        }
        .border-left-info {
            border-left: 4px solid #36b9cc !important;
        }
        .border-left-warning {
            border-left: 4px solid #f6c23e !important;
        }
        .quick-action-card {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        .quick-action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            border-color: var(--primary-color);
        }
        .quick-action-card i {
            color: var(--primary-color);
            transition: color 0.3s ease;
        }
        .quick-action-card:hover i {
            color: var(--accent-orange);
        }
    </style>
</head>
<body>
    <%- include('../common/header') %>
    
    <div class="container-fluid">
        <div class="row">
            <!-- Main Content -->
            <main class="col-md-12 ms-sm-auto px-md-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                    <h1 class="h2"><i class="fas fa-shield-alt me-2 text-primary"></i>Dashboard Amministratore</h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.location.reload()">
                                <i class="fas fa-sync-alt"></i> Aggiorna
                            </button>
                            <button type="button" class="btn btn-sm btn-primary" onclick="showProfiloModal()">
                                <i class="fas fa-user-cog"></i> Profilo
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Alert Messages -->
                <% if (typeof success !== 'undefined' && success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <% if (typeof error !== 'undefined' && error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <%= error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <% } %>

                <!-- Statistiche Cards -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card admin-stat-card border-left-primary shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                            Totale Utenti</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= stats.totalUtenti || 0 %>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-users fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card admin-stat-card border-left-success shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                            Meccanici Attivi</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= stats.totalMeccanici || 0 %>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-tools fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card admin-stat-card border-left-info shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                            Totale Riparazioni</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= stats.totalRiparazioni || 0 %>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-wrench fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card admin-stat-card border-left-warning shadow h-100 py-2">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                            Meccanici in Attesa</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                                            <%= meccaniciInAttesa ? meccaniciInAttesa.length : 0 %>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Azioni Rapide -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <h4 class="mb-3"><i class="fas fa-bolt text-primary me-2"></i>Azioni Rapide</h4>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
                        <div class="card quick-action-card h-100" onclick="showGestisciUtentiModal()" style="cursor: pointer;">
                            <div class="card-body text-center">
                                <i class="fas fa-users fa-3x mb-3 text-primary"></i>
                                <h6 class="card-title">Gestisci Utenti</h6>
                                <small class="text-muted">Visualizza e gestisci tutti gli utenti</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
                        <div class="card quick-action-card h-100" onclick="showVerificaMeccaniciModal()" style="cursor: pointer;">
                            <div class="card-body text-center">
                                <i class="fas fa-user-cog fa-3x mb-3 text-warning"></i>
                                <h6 class="card-title">Verifica Meccanici</h6>
                                <small class="text-muted">Approva o rifiuta meccanici</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
                        <div class="card quick-action-card h-100" onclick="showNotificheModal()" style="cursor: pointer;">
                            <div class="card-body text-center">
                                <i class="fas fa-bell fa-3x mb-3 text-info"></i>
                                <h6 class="card-title">Notifiche 
                                    <% if (notifiche && notifiche.length > 0) { %>
                                        <span class="badge bg-danger ms-1"><%= notifiche.length %></span>
                                    <% } %>
                                </h6>
                                <small class="text-muted">Centro notifiche sistema</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
                        <div class="card quick-action-card h-100" onclick="showProfiloModal()" style="cursor: pointer;">
                            <div class="card-body text-center">
                                <i class="fas fa-cog fa-3x mb-3 text-success"></i>
                                <h6 class="card-title">Impostazioni</h6>
                                <small class="text-muted">Configurazioni amministratore</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Meccanici in Attesa di Verifica -->
                <% if (meccaniciInAttesa && meccaniciInAttesa.length > 0) { %>
                <div class="row mb-4">
                    <div class="col-md-12">
                        <h4 class="mb-3"><i class="fas fa-user-clock text-warning me-2"></i>Meccanici in Attesa di Verifica</h4>
                        <div class="row">
                            <% meccaniciInAttesa.slice(0, 3).forEach(meccanico => { %>
                                <div class="col-md-4 mb-3">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning text-dark">
                                            <h6 class="mb-0">
                                                <i class="fas fa-user me-2"></i>
                                                <%= meccanico.nome %> <%= meccanico.cognome %>
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-1"><strong>Email:</strong> <%= meccanico.email %></p>
                                            <p class="mb-1"><strong>Telefono:</strong> <%= meccanico.telefono || 'Non specificato' %></p>
                                            <p class="mb-3"><strong>Data Richiesta:</strong> <%= new Date(meccanico.data_registrazione).toLocaleDateString('it-IT') %></p>
                                            <div class="btn-group w-100">
                                                <button class="btn btn-success btn-sm" onclick="verificaMeccanicoAction(<%= meccanico.id %>)">
                                                    <i class="fas fa-check"></i> Approva
                                                </button>
                                                <button class="btn btn-danger btn-sm" onclick="rifiutaMeccanicoAction(<%= meccanico.id %>)">
                                                    <i class="fas fa-times"></i> Rifiuta
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                            <% if (meccaniciInAttesa.length > 3) { %>
                                <div class="col-md-12 text-center">
                                    <button class="btn btn-outline-warning" onclick="showVerificaMeccaniciModal()">
                                        Visualizza tutti (<%= meccaniciInAttesa.length %> meccanici)
                                    </button>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Attività Recente -->
                <div class="row">
                    <div class="col-md-12">
                        <h4 class="mb-3"><i class="fas fa-history text-info me-2"></i>Attività Recente</h4>
                        <div class="card">
                            <div class="card-body">
                                <% if (riparazioniRecenti && riparazioniRecenti.length > 0) { %>
                                    <% riparazioniRecenti.forEach(riparazione => { %>
                                        <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                            <div class="flex-shrink-0 me-3">
                                                <i class="fas fa-wrench fa-lg text-primary"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">Riparazione #<%= riparazione.id %> - <%= riparazione.servizio %></h6>
                                                <p class="mb-1 text-muted">
                                                    Cliente: <%= riparazione.cliente_nome %> | 
                                                    Stato: <span class="badge bg-<%= riparazione.stato === 'completata' ? 'success' : riparazione.stato === 'in_corso' ? 'warning' : 'secondary' %>"><%= riparazione.stato %></span>
                                                </p>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="text-center text-muted py-3">
                                        <i class="fas fa-history fa-3x mb-3"></i>
                                        <p>Nessuna attività recente</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Modal Profilo Admin -->
    <div class="modal fade" id="profiloModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-cog me-2"></i>Profilo Amministratore</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="updateProfileForm" action="/admin/aggiorna-profilo" method="POST">
                        <div class="mb-3">
                            <label for="adminNome" class="form-label">Nome</label>
                            <input type="text" class="form-control" id="adminNome" name="nome" value="<%= admin.nome %>" required>
                        </div>
                        <div class="mb-3">
                            <label for="adminEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="adminEmail" name="email" value="<%= admin.email %>" required>
                        </div>
                        <hr>
                        <h6>Cambia Password (Opzionale)</h6>
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">Password Attuale</label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword">
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">Nuova Password</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword">
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Conferma Nuova Password</label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                    <button type="submit" form="updateProfileForm" class="btn btn-primary">Salva Modifiche</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Gestisci Utenti -->
    <div class="modal fade" id="gestisciUtentiModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-users me-2"></i>Gestisci Utenti</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <input type="text" id="searchUtenti" class="form-control" placeholder="Cerca utenti...">
                        </div>
                        <div class="col-md-3">
                            <select id="filterTipoUtente" class="form-select">
                                <option value="">Tutti i tipi</option>
                                <option value="cliente">Clienti</option>
                                <option value="meccanico">Meccanici</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select id="filterStatoUtente" class="form-select">
                                <option value="">Tutti gli stati</option>
                                <option value="attivo">Attivi</option>
                                <option value="sospeso">Sospesi</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Email</th>
                                    <th>Tipo</th>
                                    <th>Stato</th>
                                    <th>Data Registrazione</th>
                                    <th>Azioni</th>
                                </tr>
                            </thead>
                            <tbody id="utentiTableBody">
                                <% if (utenti && utenti.length > 0) { %>
                                    <% utenti.forEach(utente => { %>
                                        <tr>
                                            <td><%= utente.id %></td>
                                            <td><%= utente.nome %> <%= utente.cognome %></td>
                                            <td><%= utente.email %></td>
                                            <td>
                                                <span class="badge bg-<%= utente.tipo_utente === 'meccanico' ? 'primary' : 'success' %>">
                                                    <%= utente.tipo_utente %>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= (utente.stato === 'attivo' || !utente.stato) ? 'success' : 'danger' %>">
                                                    <%= utente.stato || 'attivo' %>
                                                </span>
                                            </td>
                                            <td><%= new Date(utente.data_registrazione).toLocaleDateString('it-IT') %></td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary" onclick="visualizzaDettagliUtente(<%= utente.id %>)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-warning" onclick="modificaStatoUtente(<%= utente.id %>, '<%= (utente.stato === 'attivo' || !utente.stato) ? 'sospeso' : 'attivo' %>')">
                                                        <i class="fas fa-<%= (utente.stato === 'attivo' || !utente.stato) ? 'ban' : 'check' %>"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Nessun utente trovato</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Verifica Meccanici -->
    <div class="modal fade" id="verificaMeccaniciModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-user-cog me-2"></i>Verifica Meccanici</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <% if (meccaniciInAttesa && meccaniciInAttesa.length > 0) { %>
                        <div class="row">
                            <% meccaniciInAttesa.forEach(meccanico => { %>
                                <div class="col-md-6 mb-4">
                                    <div class="card border-warning">
                                        <div class="card-header bg-warning text-dark">
                                            <h6 class="mb-0">
                                                <i class="fas fa-user-clock me-2"></i>
                                                <%= meccanico.nome %> <%= meccanico.cognome %>
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <p><strong>Email:</strong> <%= meccanico.email %></p>
                                                    <p><strong>Telefono:</strong> <%= meccanico.telefono || 'Non specificato' %></p>
                                                    <p><strong>Specializzazione:</strong> <%= meccanico.specializzazione || 'Non specificata' %></p>
                                                </div>
                                                <div class="col-md-6">
                                                    <p><strong>Esperienza:</strong> <%= meccanico.anni_esperienza || 0 %> anni</p>
                                                    <p><strong>Certificazioni:</strong> <%= meccanico.certificazioni || 'Nessuna' %></p>
                                                    <p><strong>Data Richiesta:</strong> <%= new Date(meccanico.data_registrazione).toLocaleDateString('it-IT') %></p>
                                                </div>
                                            </div>
                                            <% if (meccanico.descrizione) { %>
                                                <div class="mt-3">
                                                    <strong>Descrizione:</strong>
                                                    <p class="text-muted"><%= meccanico.descrizione %></p>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="card-footer">
                                            <div class="btn-group w-100">
                                                <button class="btn btn-success" onclick="verificaMeccanicoAction(<%= meccanico.id %>)">
                                                    <i class="fas fa-check me-1"></i> Approva
                                                </button>
                                                <button class="btn btn-danger" onclick="rifiutaMeccanicoAction(<%= meccanico.id %>)">
                                                    <i class="fas fa-times me-1"></i> Rifiuta
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-user-check fa-3x mb-3"></i>
                            <h5>Nessun meccanico in attesa di verifica</h5>
                            <p>Tutti i meccanici sono stati verificati</p>
                        </div>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Notifiche -->
    <div class="modal fade" id="notificheModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-bell me-2"></i>Notifiche</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="notificheModalContent">
                    <% if (notifiche && notifiche.length > 0) { %>
                        <% notifiche.forEach(notifica => { %>
                            <div class="alert alert-info alert-dismissible">
                                <h6><%= notifica.titolo %></h6>
                                <p class="mb-1"><%= notifica.messaggio %></p>
                                <button type="button" class="btn-close" onclick="segnaNotificaLetta(<%= notifica.id %>)"></button>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-bell-slash fa-3x mb-3"></i>
                            <p>Nessuna notifica</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <%- include('../common/scripts') %>
    
    <script>
        // Funzioni per i modal
        function showProfiloModal() {
            new bootstrap.Modal(document.getElementById('profiloModal')).show();
        }

        function showNotificheModal() {
            new bootstrap.Modal(document.getElementById('notificheModal')).show();
        }

        function showGestisciUtentiModal() {
            new bootstrap.Modal(document.getElementById('gestisciUtentiModal')).show();
        }

        function showVerificaMeccaniciModal() {
            new bootstrap.Modal(document.getElementById('verificaMeccaniciModal')).show();
        }

        // Funzioni per gestione utenti
        function visualizzaDettagliUtente(id) {
            alert('Visualizzazione dettagli utente ' + id + ' (da implementare)');
        }

        function modificaStatoUtente(id, nuovoStato) {
            if (confirm('Sei sicuro di voler ' + (nuovoStato === 'sospeso' ? 'sospendere' : 'riattivare') + ' questo utente?')) {
                fetch('/admin/modifica-stato-utente/' + id, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ stato: nuovoStato })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Errore: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Errore nella modifica dello stato utente');
                });
            }
        }

        // Funzioni per verifica meccanici
        function verificaMeccanicoAction(id) {
            if (confirm('Sei sicuro di voler verificare questo meccanico?')) {
                fetch('/admin/verifica-meccanico', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: id, azione: 'approva' })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message || 'Meccanico verificato con successo!');
                        location.reload();
                    } else {
                        alert('Errore: ' + (data.message || data.error || 'Errore sconosciuto'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Errore nella verifica del meccanico');
                });
            }
        }

        function rifiutaMeccanicoAction(id) {
            if (confirm('Sei sicuro di voler rifiutare questo meccanico?')) {
                fetch('/admin/verifica-meccanico', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: id, azione: 'rifiuta' })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message || 'Meccanico rifiutato con successo!');
                        location.reload();
                    } else {
                        alert('Errore: ' + (data.message || data.error || 'Errore sconosciuto'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Errore nel rifiuto del meccanico');
                });
            }
        }

        function segnaNotificaLetta(id) {
            fetch('/admin/notifica-letta/' + id, { 
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => console.error('Error:', error));
        }

        // Funzioni di ricerca e filtro per gestione utenti
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchUtenti');
            const filterTipo = document.getElementById('filterTipoUtente');
            const filterStato = document.getElementById('filterStatoUtente');

            if (searchInput && filterTipo && filterStato) {
                [searchInput, filterTipo, filterStato].forEach(element => {
                    element.addEventListener('input', filterUtenti);
                });
            }
        });

        function filterUtenti() {
            const searchTerm = document.getElementById('searchUtenti').value.toLowerCase();
            const filterTipo = document.getElementById('filterTipoUtente').value;
            const filterStato = document.getElementById('filterStatoUtente').value;
            const rows = document.querySelectorAll('#utentiTableBody tr');

            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 1) {
                    const nome = cells[1].textContent.toLowerCase();
                    const email = cells[2].textContent.toLowerCase();
                    const tipo = cells[3].textContent.toLowerCase();
                    const stato = cells[4].textContent.toLowerCase();

                    const matchSearch = nome.includes(searchTerm) || email.includes(searchTerm);
                    const matchTipo = !filterTipo || tipo.includes(filterTipo);
                    const matchStato = !filterStato || stato.includes(filterStato);

                    row.style.display = matchSearch && matchTipo && matchStato ? '' : 'none';
                }
            });
        }
    </script>
</body>
</html>
