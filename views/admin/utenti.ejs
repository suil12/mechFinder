<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Gestione Utenti - MechFinder Admin">
  <meta name="keywords" content="admin, utenti, clienti, meccanici">
  <meta name="author" content="MechFinder">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <title>Gestione Utenti - MechFinder Admin</title>
</head>
<body class="admin-body">
  <div class="admin-container">
    <!-- Sidebar -->
    <div class="admin-sidebar">
      <div class="sidebar-header">
        <img src="/media/img/logo.png" alt="MechFinder" class="sidebar-logo">
        <h3>MechFinder</h3>
        <span class="badge bg-primary">Admin</span>
      </div>
      
      <nav class="sidebar-nav">
        <ul>
          <li>
            <a href="/admin/dashboard">
              <i class="fas fa-tachometer-alt"></i>
              <span>Dashboard</span>
            </a>
          </li>
          <li class="active">
            <a href="/admin/utenti">
              <i class="fas fa-users"></i>
              <span>Utenti</span>
            </a>
          </li>
          <li>
            <a href="/admin/meccanici">
              <i class="fas fa-user-cog"></i>
              <span>Meccanici</span>
            </a>
          </li>
          <li>
            <a href="/admin/riparazioni">
              <i class="fas fa-tools"></i>
              <span>Riparazioni</span>
            </a>
          </li>
          <li>
            <a href="/admin/profilo">
              <i class="fas fa-user"></i>
              <span>Profilo</span>
            </a>
          </li>
          <li class="sidebar-divider"></li>
          <li>
            <a href="/auth/logout">
              <i class="fas fa-sign-out-alt"></i>
              <span>Logout</span>
            </a>
          </li>
        </ul>
      </nav>
      
      <div class="sidebar-footer">
        <p class="version">v1.0.0</p>
        <p class="user-info"><%= user.nome %> <%= user.cognome %></p>
      </div>
    </div>
    
    <!-- Main Content -->
    <div class="admin-content">
      <div class="admin-topbar">
        <button id="sidebarToggle" class="sidebar-toggle">
          <i class="fas fa-bars"></i>
        </button>
        
        <div class="topbar-title">
          <h2>Gestione Utenti</h2>
          <p class="breadcrumb">
            <a href="/admin/dashboard">Dashboard</a> / Utenti
          </p>
        </div>
        
        <div class="topbar-actions">
          <button class="btn btn-outline-primary" onclick="refreshData()">
            <i class="fas fa-sync-alt"></i> Aggiorna
          </button>
        </div>
      </div>
      
      <div class="admin-main">
        <!-- Filtri -->
        <div class="card mb-4">
          <div class="card-body">
            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label">Tipo Utente</label>
                <select id="filterTipo" class="form-select">
                  <option value="">Tutti</option>
                  <option value="cliente">Clienti</option>
                  <option value="meccanico">Meccanici</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Stato</label>
                <select id="filterStato" class="form-select">
                  <option value="">Tutti</option>
                  <option value="attivo">Attivi</option>
                  <option value="sospeso">Sospesi</option>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label">Cerca</label>
                <input type="text" id="searchInput" class="form-control" placeholder="Nome, email, telefono...">
              </div>
              <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="applyFilters()">
                  <i class="fas fa-search"></i> Filtra
                </button>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Statistiche utenti -->
        <div class="row mb-4">
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-primary">
                <i class="fas fa-users"></i>
              </div>
              <div class="stat-content">
                <h3 id="totalUtenti"><%= clienti.length + meccanici.length %></h3>
                <p>Totale Utenti</p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-success">
                <i class="fas fa-user"></i>
              </div>
              <div class="stat-content">
                <h3 id="totalClienti"><%= clienti.length %></h3>
                <p>Clienti</p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-warning">
                <i class="fas fa-user-cog"></i>
              </div>
              <div class="stat-content">
                <h3 id="totalMeccanici"><%= meccanici.length %></h3>
                <p>Meccanici</p>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-danger">
                <i class="fas fa-user-times"></i>
              </div>
              <div class="stat-content">
                <h3 id="utentiSospesi"><%= (clienti.filter(c => c.stato === 'sospeso').length + meccanici.filter(m => m.stato === 'sospeso').length) %></h3>
                <p>Sospesi</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Tabella utenti -->
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Lista Utenti</h5>
            <div>
              <button class="btn btn-sm btn-outline-secondary" onclick="exportData()">
                <i class="fas fa-download"></i> Esporta
              </button>
            </div>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover" id="utentiTable">
                <thead>
                  <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Tipo</th>
                    <th>Telefono</th>
                    <th>Data Registrazione</th>
                    <th>Stato</th>
                    <th>Azioni</th>
                  </tr>
                </thead>
                <tbody>
                  <% [...clienti, ...meccanici].forEach(utente => { %>
                  <tr data-tipo="<%= utente.tipo %>" data-stato="<%= utente.stato || 'attivo' %>">
                    <td>
                      <div class="d-flex align-items-center">
                        <div class="user-avatar me-2">
                          <% if (utente.tipo === 'cliente') { %>
                            <i class="fas fa-user text-primary"></i>
                          <% } else { %>
                            <i class="fas fa-user-cog text-warning"></i>
                          <% } %>
                        </div>
                        <div>
                          <div class="fw-bold"><%= utente.nome %> <%= utente.cognome %></div>
                          <% if (utente.tipo === 'meccanico' && utente.officina) { %>
                            <small class="text-muted"><%= utente.officina %></small>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td><%= utente.email %></td>
                    <td>
                      <% if (utente.tipo === 'cliente') { %>
                        <span class="badge bg-primary">Cliente</span>
                      <% } else { %>
                        <span class="badge bg-warning">Meccanico</span>
                      <% } %>
                    </td>
                    <td><%= utente.telefono || 'N/A' %></td>
                    <td><%= new Date(utente.created_at).toLocaleDateString('it-IT') %></td>
                    <td>
                      <% if (utente.stato === 'sospeso') { %>
                        <span class="badge bg-danger">Sospeso</span>
                      <% } else { %>
                        <span class="badge bg-success">Attivo</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" onclick="viewUser(<%= utente.id %>, '<%= utente.tipo %>')">
                          <i class="fas fa-eye"></i>
                        </button>
                        <% if (utente.stato === 'sospeso') { %>
                          <button class="btn btn-sm btn-outline-success" onclick="riattivaUtente(<%= utente.id %>, '<%= utente.tipo %>')">
                            <i class="fas fa-user-check"></i>
                          </button>
                        <% } else { %>
                          <button class="btn btn-sm btn-outline-danger" onclick="sospendiUtente(<%= utente.id %>, '<%= utente.tipo %>')">
                            <i class="fas fa-user-times"></i>
                          </button>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Modal Dettagli Utente -->
  <div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Dettagli Utente</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="userModalBody">
          <!-- Contenuto caricato dinamicamente -->
        </div>
      </div>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Toggle sidebar
    document.getElementById('sidebarToggle').addEventListener('click', function() {
      document.querySelector('.admin-sidebar').classList.toggle('collapsed');
    });
    
    // Funzioni per gestione utenti
    function sospendiUtente(id, tipo) {
      if (confirm('Sei sicuro di voler sospendere questo utente?')) {
        fetch(`/admin/utenti/${id}/sospendi`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ tipo: tipo })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            alert('Errore durante la sospensione');
          }
        })
        .catch(error => {
          console.error('Errore:', error);
          alert('Errore durante la sospensione');
        });
      }
    }
    
    function riattivaUtente(id, tipo) {
      if (confirm('Sei sicuro di voler riattivare questo utente?')) {
        fetch(`/admin/utenti/${id}/riattiva`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ tipo: tipo })
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            alert('Errore durante la riattivazione');
          }
        })
        .catch(error => {
          console.error('Errore:', error);
          alert('Errore durante la riattivazione');
        });
      }
    }
    
    function viewUser(id, tipo) {
      fetch(`/admin/utenti/${id}?tipo=${tipo}`)
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            const user = data.utente;
            let modalContent = `
              <div class="row">
                <div class="col-md-6">
                  <h6>Informazioni Personali</h6>
                  <p><strong>Nome:</strong> ${user.nome} ${user.cognome}</p>
                  <p><strong>Email:</strong> ${user.email}</p>
                  <p><strong>Telefono:</strong> ${user.telefono || 'N/A'}</p>
                  <p><strong>Tipo:</strong> ${user.tipo}</p>
                  <p><strong>Stato:</strong> ${user.stato || 'attivo'}</p>
                </div>
                <div class="col-md-6">
                  <h6>Dati Registrazione</h6>
                  <p><strong>Data:</strong> ${new Date(user.created_at).toLocaleString('it-IT')}</p>
                  <p><strong>IP:</strong> ${user.ip || 'N/A'}</p>
            `;
            
            if (tipo === 'meccanico') {
              modalContent += `
                  <h6 class="mt-3">Informazioni Officina</h6>
                  <p><strong>Nome Officina:</strong> ${user.officina || 'N/A'}</p>
                  <p><strong>Indirizzo:</strong> ${user.indirizzo || 'N/A'}</p>
                  <p><strong>Specializzazioni:</strong> ${user.specializzazioni || 'N/A'}</p>
                  <p><strong>Verifica:</strong> ${user.verificato ? 'Verificato' : 'Non verificato'}</p>
              `;
            }
            
            modalContent += `
                </div>
              </div>
            `;
            
            document.getElementById('userModalBody').innerHTML = modalContent;
            new bootstrap.Modal(document.getElementById('userModal')).show();
          }
        })
        .catch(error => {
          console.error('Errore:', error);
          alert('Errore nel caricamento dei dati utente');
        });
    }
    
    function applyFilters() {
      const filterTipo = document.getElementById('filterTipo').value;
      const filterStato = document.getElementById('filterStato').value;
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      
      const rows = document.querySelectorAll('#utentiTable tbody tr');
      
      rows.forEach(row => {
        const tipo = row.dataset.tipo;
        const stato = row.dataset.stato;
        const text = row.textContent.toLowerCase();
        
        let show = true;
        
        if (filterTipo && tipo !== filterTipo) show = false;
        if (filterStato && stato !== filterStato) show = false;
        if (searchTerm && !text.includes(searchTerm)) show = false;
        
        row.style.display = show ? '' : 'none';
      });
    }
    
    function refreshData() {
      location.reload();
    }
    
    function exportData() {
      window.open('/admin/utenti/export', '_blank');
    }
  </script>
</body>
</html>
