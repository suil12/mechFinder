<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Dashboard Meccanico - MechFinder">
    <meta name="keywords" content="meccanici, dashboard, riparazioni, officina">
    <meta name="author" content="MechFinder">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <title><%= title %></title>
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-logo">
                    <img src="/media/img/logo.png" alt="MechFinder">
                    <span>MechFinder</span>
                </a>
                <button id="sidebarToggle" class="sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            
            <nav class="sidebar-nav">
                <ul>
                    <!-- Menu vuoto - solo logout in fondo -->
                </ul>
            </nav>
            
            <div class="sidebar-footer">
                <a href="/auth/logout" class="btn btn-outline-danger w-100 mb-2">
                    <i class="fas fa-sign-out-alt me-2"></i>
                    <span>Logout</span>
                </a>
                <div class="user-info text-center">
                    <small class="d-block text-muted mb-1"><%= user.nome %> <%= user.cognome %></small>
                    <small class="d-block text-muted">MechFinder v1.0</small>
                </div>
            </div>
        </div>
        
        <div class="dashboard-main">
            <!-- Header fisso -->
            <div class="dashboard-header">
                <div class="header-title">
                    <h2>Dashboard Meccanico</h2>
                    <p class="text-muted mb-0">Benvenuto, <%= user.nome %></p>
                </div>
                
                <div class="header-user">
                    <div class="notifications me-3">
                        <div class="dropdown">
                            <button class="btn btn-light position-relative notification-btn" type="button" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-bell"></i>
                                <% if (typeof richiestePendenti !== 'undefined' && richiestePendenti && richiestePendenti.length > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        <%= richiestePendenti.length %>
                                        <span class="visually-hidden">notifiche non lette</span>
                                    </span>
                                <% } %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationsDropdown">
                                <div class="notification-header p-2 border-bottom d-flex justify-content-between align-items-center">
                                    <h6 class="m-0">Notifiche</h6>
                                    <span class="badge bg-primary"><%= richiestePendenti ? richiestePendenti.length : 0 %></span>
                                </div>
                                
                                <% if (richiestePendenti && richiestePendenti.length > 0) { %>
                                    <% richiestePendenti.forEach(richiesta => { %>
                                        <li>
                                            <a class="dropdown-item notification-item" href="#" onclick="mostraDettagliRichiesta('<%= richiesta.id %>')">
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-shrink-0 me-2">
                                                        <i class="fas fa-tools bg-primary text-white p-2 rounded-circle"></i>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <p class="mb-0">Nuova richiesta da <%= richiesta.nome_cliente %> <%= richiesta.cognome_cliente %></p>
                                                        <small class="text-muted"><%= new Date(richiesta.data_richiesta).toLocaleDateString() %></small>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                    <% }) %>
                                <% } else { %>
                                    <li><p class="dropdown-item text-center text-muted py-2 mb-0">Nessuna nuova notifica</p></li>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                    
                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="<%= user.avatar || '/media/img/default_mechanic.png' %>" alt="<%= user.nome %>" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;">
                            <span><%= user.nome %> <%= user.cognome %></span>
                            <i class="fas fa-chevron-down ms-2 small"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <div class="dashboard-content">
                <!-- Quick actions -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Azioni rapide</h5>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <button class="btn btn-primary w-100" onclick="mostraRichiestePendenti()">
                                            <i class="fas fa-clock me-2"></i>
                                            Richieste Pendenti
                                        </button>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-success w-100" onclick="mostraLavorazioniAttive()">
                                            <i class="fas fa-tools me-2"></i>
                                            Lavorazioni Attive
                                        </button>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-warning w-100" onclick="apriModalNuovoPreventivo()">
                                            <i class="fas fa-calculator me-2"></i>
                                            Nuovo Preventivo
                                        </button>
                                    </div>
                                    <div class="col-md-3">
                                        <button class="btn btn-info w-100" onclick="mostraStatistiche()">
                                            <i class="fas fa-chart-bar me-2"></i>
                                            Statistiche
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistiche generali -->
                <div class="row mb-4">
                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Richieste Pendenti</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= richiestePendenti ? richiestePendenti.length : 0 %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Lavorazioni Attive</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= lavorazioniAttive ? lavorazioniAttive.length : 0 %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-tools fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Completate questo mese</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= stats.riparazioniMese || 0 %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-body">
                                <div class="row no-gutters align-items-center">
                                    <div class="col mr-2">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Guadagno mensile</div>
                                        <div class="h5 mb-0 font-weight-bold text-gray-800">€ <%= stats.guadagnoMese ? stats.guadagnoMese.toFixed(2) : '0.00' %></div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="fas fa-euro-sign fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Richieste pendenti -->
                    <div class="col-xl-8 col-lg-12 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                <h6 class="m-0 font-weight-bold text-primary">Richieste di riparazione pendenti</h6>
                                <button class="btn btn-sm btn-primary" onclick="mostraRichiestePendenti()">Vedi tutte</button>
                            </div>
                            <div class="card-body">
                                <% if (richiestePendenti && richiestePendenti.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Cliente</th>
                                                    <th>Veicolo</th>
                                                    <th>Tipo Riparazione</th>
                                                    <th>Data</th>
                                                    <th>Azioni</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% richiestePendenti.slice(0, 5).forEach(richiesta => { %>
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <img class="rounded-circle me-2" width="30" height="30"
                                                                     src="<%= richiesta.avatar_cliente || '/media/img/default_avatar.png' %>"
                                                                     alt="<%= richiesta.nome_cliente %>">
                                                                <div>
                                                                    <%= richiesta.nome_cliente %> <%= richiesta.cognome_cliente %>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <% if (richiesta.marca && richiesta.modello) { %>
                                                                <%= richiesta.marca %> <%= richiesta.modello %>
                                                                <% if (richiesta.targa) { %>
                                                                    <small class="text-muted">(<%= richiesta.targa %>)</small>
                                                                <% } %>
                                                            <% } else { %>
                                                                <span class="text-muted">Non specificato</span>
                                                            <% } %>
                                                        </td>
                                                        <td><%= richiesta.tipo_riparazione || 'Non specificato' %></td>
                                                        <td><%= new Date(richiesta.data_richiesta).toLocaleDateString() %></td>
                                                        <td>
                                                            <button class="btn btn-sm btn-outline-primary me-1" onclick="mostraDettagliRichiesta('<%= richiesta.id %>')">
                                                                <i class="fas fa-eye"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-success me-1" onclick="accettaRichiesta('<%= richiesta.id %>')">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-danger" onclick="rifiutaRichiesta('<%= richiesta.id %>')">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">Nessuna richiesta pendente al momento</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Lavorazioni attive -->
                    <div class="col-xl-4 col-lg-12 mb-4">
                        <div class="card border-0 shadow h-100">
                            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                <h6 class="m-0 font-weight-bold text-warning">Lavorazioni attive</h6>
                                <button class="btn btn-sm btn-warning" onclick="mostraLavorazioniAttive()">Gestisci</button>
                            </div>
                            <div class="card-body">
                                <% if (lavorazioniAttive && lavorazioniAttive.length > 0) { %>
                                    <% lavorazioniAttive.slice(0, 3).forEach(lavorazione => { %>
                                        <div class="mb-3 p-3 border rounded">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-1"><%= lavorazione.nome_cliente %> <%= lavorazione.cognome_cliente %></h6>
                                                    <p class="mb-1 text-muted small"><%= lavorazione.marca %> <%= lavorazione.modello %></p>
                                                    <span class="badge bg-<%= lavorazione.stato === 'preventivo' ? 'warning' : 'info' %>">
                                                        <%= lavorazione.stato %>
                                                    </span>
                                                </div>
                                                <div class="btn-group-vertical btn-group-sm">
                                                    <button class="btn btn-outline-primary" onclick="mostraDettagliLavorazione('<%= lavorazione.id %>')">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <button class="btn btn-outline-success" onclick="aggiornaStato('<%= lavorazione.id %>')">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <i class="fas fa-tools fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">Nessuna lavorazione attiva</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: Dettagli Richiesta -->
    <div class="modal fade" id="modalDettagliRichiesta" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Dettagli Richiesta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="dettagliRichiestaContent">
                    <!-- Contenuto caricato dinamicamente -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                    <button type="button" class="btn btn-success" onclick="inviaPreventivo()">Invia Preventivo</button>
                    <button type="button" class="btn btn-danger" onclick="rifiutaRichiesta()">Rifiuta</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: Nuovo Preventivo -->
    <div class="modal fade" id="modalNuovoPreventivo" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuovo Preventivo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formNuovoPreventivo">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Richiesta di Riparazione</label>
                            <select class="form-select" name="id_riparazione" required>
                                <option value="">Seleziona una richiesta</option>
                                <!-- Popolato dinamicamente -->
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Costo Manodopera (€)</label>
                            <input type="number" step="0.01" class="form-control" name="costo_manodopera" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Costo Ricambi (€)</label>
                            <input type="number" step="0.01" class="form-control" name="costo_ricambi" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tempi di Consegna (giorni)</label>
                            <input type="number" class="form-control" name="tempi_consegna" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Note</label>
                            <textarea class="form-control" name="note" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <strong>Totale: €<span id="totalePreventivo">0.00</span></strong>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-primary">Invia Preventivo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Aggiorna Stato Lavorazione -->
    <div class="modal fade" id="modalAggiornaStato" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aggiorna Stato Lavorazione</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="formAggiornaStato">
                    <div class="modal-body">
                        <input type="hidden" name="id_riparazione" id="idRiparazioneStato">
                        <div class="mb-3">
                            <label class="form-label">Nuovo Stato</label>
                            <select class="form-select" name="stato" required>
                                <option value="preventivo">Preventivo inviato</option>
                                <option value="accettata">Riparazione accettata</option>
                                <option value="in_corso">In corso</option>
                                <option value="completata">Completata</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Note aggiuntive</label>
                            <textarea class="form-control" name="note" rows="3"></textarea>
                        </div>
                        <div class="mb-3" id="campiCompletamento" style="display: none;">
                            <label class="form-label">Costo Finale (€)</label>
                            <input type="number" step="0.01" class="form-control" name="costo_finale">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn btn-primary">Aggiorna</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Statistiche -->
    <div class="modal fade" id="modalStatistiche" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Statistiche Dettagliate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="statisticheContent">
                    <!-- Contenuto caricato dinamicamente -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Funzioni per i modal meccanico
        function mostraDettagliRichiesta(id) {
            fetch(`/meccanico/richiesta/${id}/dettagli`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const richiesta = data.richiesta;
                        document.getElementById('dettagliRichiestaContent').innerHTML = `
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Informazioni Cliente</h6>
                                    <p><strong>Nome:</strong> ${richiesta.nome_cliente} ${richiesta.cognome_cliente}</p>
                                    <p><strong>Email:</strong> ${richiesta.email_cliente}</p>
                                    <p><strong>Telefono:</strong> ${richiesta.telefono_cliente || 'Non specificato'}</p>
                                </div>
                                <div class="col-md-6">
                                    <h6>Informazioni Veicolo</h6>
                                    <p><strong>Veicolo:</strong> ${richiesta.marca || 'N/A'} ${richiesta.modello || 'N/A'}</p>
                                    <p><strong>Anno:</strong> ${richiesta.anno_veicolo || 'Non specificato'}</p>
                                    <p><strong>Targa:</strong> ${richiesta.targa || 'Non specificata'}</p>
                                </div>
                            </div>
                            <hr>
                            <h6>Dettagli Riparazione</h6>
                            <p><strong>Tipo:</strong> ${richiesta.tipo_riparazione || 'Non specificato'}</p>
                            <p><strong>Descrizione:</strong> ${richiesta.descrizione || 'Nessuna descrizione fornita'}</p>
                            <p><strong>Data richiesta:</strong> ${new Date(richiesta.data_richiesta).toLocaleString()}</p>
                        `;
                        new bootstrap.Modal(document.getElementById('modalDettagliRichiesta')).show();
                    }
                })
                .catch(error => console.error('Errore:', error));
        }

        function accettaRichiesta(id) {
            if (confirm('Sei sicuro di voler accettare questa richiesta?')) {
                fetch(`/meccanico/richiesta/${id}/accetta`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Errore:', error));
            }
        }

        function rifiutaRichiesta(id) {
            if (confirm('Sei sicuro di voler rifiutare questa richiesta?')) {
                fetch(`/meccanico/richiesta/${id}/rifiuta`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Errore:', error));
            }
        }

        function apriModalNuovoPreventivo() {
            // Carica le richieste disponibili
            fetch('/meccanico/richieste-lista')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const select = document.querySelector('#modalNuovoPreventivo select[name="id_riparazione"]');
                        select.innerHTML = '<option value="">Seleziona una richiesta</option>';
                        data.richieste.forEach(richiesta => {
                            select.innerHTML += `<option value="${richiesta.id}">
                                ${richiesta.nome_cliente} ${richiesta.cognome_cliente} - ${richiesta.marca || 'N/A'} ${richiesta.modello || 'N/A'}
                            </option>`;
                        });
                    }
                });
            new bootstrap.Modal(document.getElementById('modalNuovoPreventivo')).show();
        }

        function mostraStatistiche() {
            fetch('/meccanico/statistiche')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const stats = data.statistiche;
                        document.getElementById('statisticheContent').innerHTML = `
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Riparazioni</h6>
                                    <p>Totali: ${stats.totaleRiparazioni}</p>
                                    <p>Questo mese: ${stats.riparazioniMese}</p>
                                    <p>Media mensile: ${stats.mediaRiparazioniMese}</p>
                                </div>
                                <div class="col-md-6">
                                    <h6>Guadagni</h6>
                                    <p>Totale: €${stats.guadagnoTotale}</p>
                                    <p>Questo mese: €${stats.guadagnoMese}</p>
                                    <p>Media mensile: €${stats.mediaGuadagnoMese}</p>
                                </div>
                            </div>
                            <hr>
                            <h6>Valutazioni</h6>
                            <p>Media: ${stats.valutazioneMedia}/5</p>
                            <p>Numero recensioni: ${stats.numeroRecensioni}</p>
                        `;
                        new bootstrap.Modal(document.getElementById('modalStatistiche')).show();
                    }
                })
                .catch(error => console.error('Errore:', error));
        }

        // Calcolo totale preventivo
        document.addEventListener('DOMContentLoaded', function() {
            const costoManodopera = document.querySelector('#modalNuovoPreventivo input[name="costo_manodopera"]');
            const costoRicambi = document.querySelector('#modalNuovoPreventivo input[name="costo_ricambi"]');
            const totale = document.getElementById('totalePreventivo');

            function calcolaTotale() {
                const manodopera = parseFloat(costoManodopera.value) || 0;
                const ricambi = parseFloat(costoRicambi.value) || 0;
                totale.textContent = (manodopera + ricambi).toFixed(2);
            }

            costoManodopera.addEventListener('input', calcolaTotale);
            costoRicambi.addEventListener('input', calcolaTotale);

            // Form submit preventivo
            document.getElementById('formNuovoPreventivo').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                
                fetch('/meccanico/nuovo-preventivo', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modalNuovoPreventivo')).hide();
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Errore:', error));
            });

            // Form submit aggiorna stato
            document.getElementById('formAggiornaStato').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                
                fetch('/meccanico/aggiorna-stato', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('modalAggiornaStato')).hide();
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Errore:', error));
            });

            // Mostra/nascondi campi per completamento
            document.querySelector('#modalAggiornaStato select[name="stato"]').addEventListener('change', function() {
                const campiCompletamento = document.getElementById('campiCompletamento');
                if (this.value === 'completata') {
                    campiCompletamento.style.display = 'block';
                } else {
                    campiCompletamento.style.display = 'none';
                }
            });
        });

        function mostraRichiestePendenti() {
            // Implementa visualizzazione completa delle richieste
            alert('Funzionalità da implementare: Lista completa richieste pendenti');
        }

        function mostraLavorazioniAttive() {
            // Implementa visualizzazione completa delle lavorazioni
            alert('Funzionalità da implementare: Lista completa lavorazioni attive');
        }

        function mostraDettagliLavorazione(id) {
            // Implementa visualizzazione dettagli lavorazione
            mostraDettagliRichiesta(id);
        }

        function aggiornaStato(id) {
            document.getElementById('idRiparazioneStato').value = id;
            new bootstrap.Modal(document.getElementById('modalAggiornaStato')).show();
        }
    </script>
</body>
</html>
